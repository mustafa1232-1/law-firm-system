[
  {
    "document": {
      "title": "قانون الإثبات العراقي",
      "lawNumber": "107",
      "year": 1979,
      "issuingBody": "مجلس قيادة الثورة (سابقًا)",
      "legalDomain": "إثبات",
      "keywords": ["الإثبات", "البينة", "المحررات"],
      "sourceName": "منصة القوانين العراقية - مراجع عامة",
      "sourceUrl": "https://www.iraq-lg-law.org/"
    },
    "articles": [
      {
        "articleNumber": "1",
        "text": "البينة على من ادعى واليمين على من أنكر، ما لم يوجد نص خاص بخلاف ذلك.",
        "keywords": ["عبء الإثبات", "البينة"]
      },
      {
        "articleNumber": "10",
        "text": "للمحكمة سلطة تقدير الأدلة وفق القواعد القانونية ومجمل وقائع الدعوى.",
        "keywords": ["سلطة المحكمة", "تقدير الأدلة"]
      },
      {
        "articleNumber": "20",
        "text": "تكون للمحررات الرسمية حجية بما دون فيها من أمور قام بها الموظف المختص ضمن حدود وظيفته.",
        "keywords": ["المحررات الرسمية", "الحجية"]
      }
    ]
  },
  {
    "document": {
      "title": "القانون المدني العراقي",
      "lawNumber": "40",
      "year": 1951,
      "issuingBody": "السلطة التشريعية العراقية",
      "legalDomain": "مدني",
      "keywords": ["العقود", "الالتزامات", "المسؤولية المدنية"],
      "sourceName": "منصة القوانين العراقية - مراجع عامة",
      "sourceUrl": "https://www.iraq-lg-law.org/"
    },
    "articles": [
      {
        "articleNumber": "73",
        "text": "العقد شريعة المتعاقدين، فلا يجوز نقضه ولا تعديله إلا باتفاق الطرفين أو للأسباب التي يقررها القانون.",
        "keywords": ["العقد", "شريعة المتعاقدين"]
      },
      {
        "articleNumber": "202",
        "text": "كل خطأ سبب ضررًا للغير يوجب التعويض.",
        "keywords": ["المسؤولية التقصيرية", "التعويض"]
      },
      {
        "articleNumber": "227",
        "text": "يقدر القاضي التعويض بقدر الضرر المباشر المتوقع وقت التعاقد ما لم يوجد نص أو اتفاق يقضي بخلاف ذلك.",
        "keywords": ["تقدير التعويض", "الضرر المباشر"]
      }
    ]
  },
  {
    "document": {
      "title": "قانون أصول المحاكمات الجزائية",
      "lawNumber": "23",
      "year": 1971,
      "issuingBody": "السلطة التشريعية العراقية",
      "legalDomain": "جزائي",
      "keywords": ["إجراءات جزائية", "تحقيق", "محاكمة"],
      "sourceName": "منصة القوانين العراقية - مراجع عامة",
      "sourceUrl": "https://www.iraq-lg-law.org/"
    },
    "articles": [
      {
        "articleNumber": "1",
        "text": "تهدف إجراءات الدعوى الجزائية إلى الكشف عن الحقيقة وتحقيق العدالة مع ضمان حقوق الدفاع.",
        "keywords": ["الدعوى الجزائية", "الحقيقة", "حقوق الدفاع"]
      },
      {
        "articleNumber": "123",
        "text": "لا يجوز القبض على أي شخص أو توقيفه إلا بموجب أمر قضائي ووفق أحكام القانون.",
        "keywords": ["القبض", "التوقيف", "أمر قضائي"]
      },
      {
        "articleNumber": "213",
        "text": "يجب أن يكون الحكم الجزائي مسببًا تسبيبًا كافيًا يبين الوقائع والأدلة والأساس القانوني.",
        "keywords": ["تسبيب الحكم", "الحكم الجزائي"]
      }
    ]
  }
]
